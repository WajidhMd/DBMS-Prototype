# ==============================================================================
# PACIFIC E-COMMERCE DBMS - GOOGLE CLOUD PLATFORM (GCP) & PRODUCTION CONFIG
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Express Backend Variables (Configure in GCP Cloud Run / Secret Manager)
# ------------------------------------------------------------------------------
PORT=8080
NODE_ENV=production

# JWT Authentication Secret (Store as secret in GCP Secret Manager: ecommerce_jwt_secret)
JWT_SECRET=replace_with_a_long_random_jwt_secret_in_production

# Frontend Origin for CORS (Your Cloud Run frontend domain or custom domain)
FRONTEND_URL=https://ecommerce-frontend-<hash>-<region>.a.run.app
CLIENT_URL=https://ecommerce-frontend-<hash>-<region>.a.run.app

# ------------------------------------------------------------------------------
# 2. Google Cloud SQL for PostgreSQL Configuration
# ------------------------------------------------------------------------------
# Option A: Cloud Run Unix Domain Socket (Recommended by Google Cloud)
# Add Cloud SQL Connection in Cloud Run: PROJECT_ID:REGION:INSTANCE_NAME
CLOUD_SQL_CONNECTION_NAME=your-gcp-project:us-central1:ecommerce-postgres-instance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DATABASE=ecommerce_db

# Option B: Standard Connection String or TCP Host
DATABASE_URL=postgresql://postgres:password@10.0.0.1:5432/ecommerce_db
POSTGRES_HOST=10.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSL=true

# ------------------------------------------------------------------------------
# 3. MongoDB Atlas Configuration (Store in Secret Manager: ecommerce_mongo_uri)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=ecommerce_db

# ------------------------------------------------------------------------------
# 4. React Vite Frontend Variables (Embed during Cloud Run Frontend Container Build)
# ------------------------------------------------------------------------------
# Your public Cloud Run backend URL without trailing /api
VITE_API_URL=https://ecommerce-backend-<hash>-<region>.a.run.app
