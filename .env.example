# ==============================================================================
# PACIFIC E-COMMERCE DBMS - PRODUCTION & LOCAL ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Express Backend Variables (Configure in Railway / Server)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
JWT_SECRET=replace_with_a_long_random_jwt_secret_in_production

# Allowed Frontend Origins for CORS (Vercel domain without trailing slash)
FRONTEND_URL=https://your-frontend-app.vercel.app
CLIENT_URL=https://your-frontend-app.vercel.app

# PostgreSQL Database Configuration (Railway PostgreSQL provides DATABASE_URL automatically)
DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway
# Alternatively, individual connection parameters:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DATABASE=ecommerce_db
POSTGRES_SSL=true

# MongoDB Database Configuration (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=ecommerce_db

# ------------------------------------------------------------------------------
# 2. React Vite Frontend Variables (Configure in Vercel Environment Variables)
# ------------------------------------------------------------------------------
# Your public Railway backend URL (without trailing /api)
VITE_API_URL=https://your-backend-app.up.railway.app
